# GCP Configuration
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1
DOCAI_LOCATION=us
DOCAI_LAYOUT_PROCESSOR_ID=your-layout-processor-id
DOCAI_FORM_PROCESSOR_ID=your-form-processor-id

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/rag_analyzer

# Redis Configuration
REDIS_URL=redis://localhost:6383/0

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# File Upload Settings
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=/tmp/uploads

# Processing Settings
MAX_WORKERS=3
EMBEDDING_BATCH_SIZE=50

# Model Selection Configuration
# Set USE_MULTI_MODEL=false to use only one model (faster, cheaper)
# Set USE_MULTI_MODEL=true to use all available models (better consensus, slower)
USE_MULTI_MODEL=true
# When USE_MULTI_MODEL=false, specify which model to use
# Options: llama-scout, gemini-flash, gpt-oss
PRIMARY_MODEL=llama-scout

# Confidence Scoring Configuration
# Thresholds for categorizing findings (0.0 to 1.0)
HIGH_CONFIDENCE_THRESHOLD=0.95
MEDIUM_CONFIDENCE_THRESHOLD=0.80
# Consensus calculation method: agreement, confidence, or hybrid
CONSENSUS_METHOD=hybrid
# Minimum percentage of models that must agree (0.0 to 1.0)
MIN_MODEL_AGREEMENT=0.66

# Iterative Refinement Configuration
# Maximum number of iterations to refine a document
MAX_ITERATIONS=5
# Maximum high-confidence findings to consider converged (0 = perfect compliance)
CONVERGENCE_THRESHOLD=0
# Maximum medium-confidence findings to consider converged
MEDIUM_CONVERGENCE_THRESHOLD=0

# Critique System Configuration
# Enable multi-LLM critique workflow (Proposer → Critic → Refiner)
ENABLE_CRITIQUE_SYSTEM=true
# Model for initial findings detection
PROPOSER_MODEL=gemini-flash
# Model for critique and validation (should be different from proposer)
CRITIC_MODEL=llama-scout
# Enable critique even when using single model (self-critique)
USE_CRITIQUE_IN_SINGLE_MODEL=true
